{
  "name": "@slurrps/chippy",
  "author": "Slurrps",
  "license": "MIT",
  "private": false,
  "version": "1.3.0",
  "type": "module",
  "main": "./dist/chip8.js",
  "types": "./dist/chip8.d.ts",
  "description": "A Chip-8 / SUPER-CHIP / XO-CHIP emulator written in TypeScript with zero runtime dependencies",
  "exports": {
    ".": {
      "import": "./dist/chip8.js",
      "types": "./dist/chip8.d.ts"
    }
  },
  "files": [
    "dist/chip8.js",
    "dist/chip8.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "webpack",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "chip8",
    "chip-8",
    "superchip",
    "xo-chip",
    "emulator",
    "game",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slurrps/Chippy_NPM_Package.git"
  },
  "bugs": {
    "url": "https://github.com/Slurrps/Chippy_NPM_Package/issues"
  },
  "homepage": "https://slurrps.github.io/Chippy_NPM_Package/"
}
